{
  "manifest_version": 3,
  "name": "InfoBoard",
  "version": "0.1.0",
  "description": "Search eligible open browser tabs.",
  "permissions": ["storage", "tabs", "tabGroups"],
  "background": {
    "service_worker": "dist/src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open InfoBoard search",
    "default_popup": "dist/search/surface-shell.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+W", "mac": "Command+Shift+K" },
      "description": "Open InfoBoard tab search"
    }
  }
}
