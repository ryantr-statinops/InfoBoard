      "fixture_id": "FX-TAB-EVENTS",
      "private_access": true,
      "initial": {
        "windows": [{ "id": 1, "incognito": false }],
        "groups": [{ "id": 7, "windowId": 1, "title": "Old group" }],
        "tabs": [
          { "id": 10, "windowId": 1, "groupId": 7, "title": "Alpha", "url": "https://alpha.example/a", "pinned": false, "active": false, "incognito": false },
          { "id": 11, "windowId": 1, "groupId": -1, "title": "Temporary", "url": "https://temporary.example/a", "pinned": false, "active": true, "incognito": false }
        ]
      },
      "events": [
        { "source": "tabs.onMoved", "args": [10, { "windowId": 1, "fromIndex": 0, "toIndex": 1 }] },
        { "source": "tabs.onCreated", "args": [{ "id": 12, "windowId": 1, "groupId": -1, "title": "Transient", "url": "https://transient.example/", "pinned": false, "active": false, "incognito": false }] },
        { "source": "tabs.onUpdated", "args": [10, { "title": "Beta" }, { "id": 10, "windowId": 1, "groupId": 7, "title": "Beta", "url": "https://alpha.example/a", "pinned": false, "active": false, "incognito": false }] },
        { "source": "tabGroups.onUpdated", "args": [{ "id": 7, "windowId": 1, "title": "New group" }] },
        { "source": "tabs.onUpdated", "args": [10, { "pinned": true }, { "id": 10, "windowId": 1, "groupId": 7, "title": "Beta", "url": "https://alpha.example/a", "pinned": true, "active": false, "incognito": false }] },
        { "source": "tabs.onActivated", "args": [{ "tabId": 10, "windowId": 1 }] },
        { "source": "tabs.onRemoved", "args": [11, { "windowId": 1, "isWindowClosing": false }] },
        { "source": "tabs.onRemoved", "args": [12, { "windowId": 1, "isWindowClosing": false }] }
      ],
      "expected": { "tab_ids": [10], "records": [{ "tab_id": 10, "title": "Beta", "group_label": "New group", "pinned": true, "active": true }], "status": "ready" }
    },
