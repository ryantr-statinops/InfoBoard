    {
      "case_id": "result_limit_zero",
      "kind": "result_limit",
      "observed": 0,
      "expected": "PAYLOAD_LIMIT",
      "bound": "result_limit<=50"
    },
    {
      "case_id": "result_limit_high",
      "kind": "result_limit",
      "observed": 51,
      "expected": "PAYLOAD_LIMIT",
      "bound": "result_limit<=50"
    },
    {
      "case_id": "snapshot_operating_tabs",
      "kind": "snapshot_tabs",
