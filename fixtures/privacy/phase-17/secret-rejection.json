{
  "fixture_id": "FX-PRIVACY-SECRET-REJECTION",
  "owner_phase": "IP-17",
  "requirement_ids": ["NFR-009", "NFR-007"],
  "cases": [
    {
      "case_id": "authorization_header",
      "field": "auth_header",
      "value": "Bearer SENTINEL-AUTH-4c1d",
      "expected_kind": "auth_header"
    },
    {
      "case_id": "cookie_field",
      "field": "cookie",
      "value": "session=SENTINEL-COOKIE-9a2f",
      "expected_kind": "cookie"
    },
    {
      "case_id": "token_value",
      "field": "title_display",
      "value": "ghp_SENTINELTOKEN123456",
      "expected_kind": "token"
    },
    {
      "case_id": "private_key_value",
      "field": "page_content",
      "value": "-----BEGIN PRIVATE KEY-----SENTINEL",
      "expected_kind": "private_key"
    },
    {
      "case_id": "credential_pair",
      "field": "url_search",
      "value": "https://example.test/path?token=SENTINEL-TOKEN",
      "expected_kind": "credential"
    },
    {
      "case_id": "environment_secret",
      "field": "environment_secret",
      "value": "SENTINEL-ENV-7f3a",
      "expected_kind": "environment_secret"
    }
  ],
  "expected": {
    "observations": [
      {
        "signal": "secret_shapes_rejected",
        "value": true
      },
      {
        "signal": "raw_secret_echoed",
        "value": false
      }
    ],
    "privacy_assertions": [
      "A secret-shaped field or value is rejected before diagnostics, storage, or export and the raw value is never echoed."
    ]
  }
}
